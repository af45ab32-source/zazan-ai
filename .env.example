# ==============================================================================
# ZAZAN AI — ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
# For Vercel: Set these variables in Project Settings > Environment Variables.
# For Local Dev: Copy this file to .env and provide your values.
# IMPORTANT: Never commit actual secret keys to git.
# ==============================================================================

# --- SERVER-SIDE SECRETS (NEVER exposed to frontend/client or Android APK) ---
# Required for AI Chat. Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional Gemini model override (defaults to gemini-3.5-flash with automatic lite/fallback cascade)
GEMINI_MODEL=gemini-3.5-flash

# Optional ElevenLabs TTS integration (if unset, app gracefully uses browser speech synthesis)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_API_URL=https://api.elevenlabs.io/v1

# Local server port (used by server.ts in local dev / Docker; Vercel automatically routes serverless functions)
PORT=3000

# Optional CORS origin override (defaults to allowing *.vercel.app, Capacitor, localhost, and native requests)
CLIENT_ORIGIN=

# --- CLIENT-SIDE / ANDROID BUILD VARIABLES (Built into frontend via Vite) ---
# The public Vercel production deployment URL for Android APK builds
# Example: https://zazan-ai.vercel.app
# For web browser deployments on Vercel, this can be empty (defaults to current origin).
VITE_API_BASE_URL=

# Supabase Auth and Conversation History
VITE_SUPABASE_URL=https://sqbzzinfdmrxyjvwrlns.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_lOk7hTWfKuDEr6r1Xc9qCA_aIx3ipIF
