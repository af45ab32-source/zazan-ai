# Copy this file to ".env" in the same folder and fill in real values.
# NEVER commit the real ".env" file — it is already excluded in .gitignore.

# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Gemini (Google GenAI SDK) — primary AI provider
# Get a free key from https://aistudio.google.com/apikey
# gemini-2.5-flash is used by default: it is on Google's free tier
# (rate-limited, not unlimited) as of this writing. Check Google's current
# pricing/rate-limit pages, since free-tier availability can change.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_default_voice_id_here
ELEVENLABS_API_URL=https://api.elevenlabs.io/v1
